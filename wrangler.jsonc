{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shopbeapicks",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "vars": {
    "NUXT_ADMIN_DEV_BYPASS": "false",
    "NUXT_ACCESS_ALLOWED_EMAILS": "alexa6425@gmail.com,shopbeapicks@gmail.com",
    "NUXT_PUBLIC_ACCESS_TEAM_DOMAIN": "flat-wave-3363.cloudflareaccess.com",
    "NUXT_PUBLIC_SITE_URL": "https://shopbeapicks-42i.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopbeapicks",
      "database_id": "71d1b92a-d9bb-478e-9acd-08bb9284233b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "shopbeapicks-images"
    }
  ]
}
